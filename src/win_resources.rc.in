#include <winres.h>

IDI_ICON1 ICON "@ICON_PATH@"

1 RT_MANIFEST "@MANIFEST_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @GIT_VERSION_COMMA@
 PRODUCTVERSION @GIT_VERSION_COMMA@
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Tenebrarium"
            VALUE "FileDescription", "Tenebrarium - RPG de mazmorras por turnos"
            VALUE "FileVersion", "@GIT_VERSION_STRING@"
            VALUE "InternalName", "tenebrarium"
            VALUE "LegalCopyright", "Copyright (C) 2026"
            VALUE "OriginalFilename", "tenebrarium.exe"
            VALUE "ProductName", "Tenebrarium"
            VALUE "ProductVersion", "@GIT_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
